# Origin the API is served from. Leave EMPTY in development: vite.config.ts
# proxies /api to the Django server, so requests stay same-origin and session
# cookies and CSRF work without any backend CORS/CSRF_TRUSTED_ORIGINS change.
# Set to the API host for production builds, e.g. https://app.mykshethra.com
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Defaults to http://localhost:8010.
# Set this if the backend is exposed differently on your machine — e.g. via
# nginx (http://localhost) or straight at the container (http://172.18.0.10:8000).
# The proxy rewrites both Host and Origin to the target, so Django's
# ALLOWED_HOSTS and CSRF origin check both see a same-origin request.
VITE_API_PROXY_TARGET=
